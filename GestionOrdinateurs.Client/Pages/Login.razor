@page "/login"
@inject HttpClient Http
@inject Blazored.SessionStorage.ISessionStorageService Session
@inject NavigationManager Nav

<h3>Connexion</h3>

<div class="w-25">
    <input @bind="login" placeholder="Identifiant (ex: etudiant)" class="form-control mb-2" />
    <input @bind="password" type="password" placeholder="Mot de passe" class="form-control mb-2" />
    <button class="btn btn-primary" @onclick="SeConnecter">Se connecter</button>
</div>

@if (!string.IsNullOrEmpty(erreur))
{
    <p class="text-danger mt-2">@erreur</p>
}

@code {
    private string login = "";
    private string password = "";
    private string erreur = "";

    private async Task SeConnecter()
    {
        erreur = "";
        try
        {
            var parameters = new Dictionary<string, string>
            {
                { "grant_type", "password" },
                { "client_id", "blazor-client" },
                { "username", login },
                { "password", password }
            };

            var content = new FormUrlEncodedContent(parameters);
            var response = await Http.PostAsync("http://localhost:8180/realms/gestion-ordinateurs/protocol/openid-connect/token", content);

            if (!response.IsSuccessStatusCode)
            {
                erreur = "Identifiants invalides ou utilisateur introuvable sur Keycloak.";
                return;
            }

            var data = await response.Content.ReadFromJsonAsync<KeycloakTokenResult>();
            if (data != null && !string.IsNullOrEmpty(data.access_token))
            {
                await Session.SetItemAsStringAsync("token", data.access_token);
                Nav.NavigateTo("/", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            erreur = $"Erreur : {ex.Message}";
        }
    }

    private class KeycloakTokenResult
    {
        public string access_token { get; set; } = "";
        public string token_type { get; set; } = "";
        public int expires_in { get; set; }
    }

    
}